config_version=5

[application]

config/name="Pegue o Ursinho"
config/description="Port Godot 4 do Pegue o Ursinho (estel.games)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
GameState="*res://autoload/game_state.gd"
Save="*res://autoload/save.gd"
I18n="*res://autoload/i18n.gd"
ApiClient="*res://autoload/api_client.gd"
Audio="*res://autoload/audio.gd"
ScreenScaler="*res://autoload/screen_scaler.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=1024
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[gui]

theme/custom="res://themes/_placeholder_theme.tres"

[ursinho]

api_base="https://estel.games"

